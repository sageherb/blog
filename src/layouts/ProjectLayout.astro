---
import type { ImageMetadata } from "astro";
import placeholderCover from "@assets/project/placeholder-cover.svg";
import ProjectCardLinks from "@components/project/ProjectCardLinks.astro";
import Badge from "@components/ui/Badge.astro";
import Prose from "@components/ui/Prose.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { formatDate, formatPeriod } from "@utils/date";
import { buildPersonJsonLd } from "@utils/jsonld";
import { Image } from "astro:assets";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  startDate?: Date;
  endDate?: Date;
  techStack?: string[];
  links?: { github?: string; live?: string };
  coverImage?: ImageMetadata;
  ogImagePath?: string;
}

const {
  title,
  description,
  pubDate,
  startDate,
  endDate,
  techStack = [],
  links,
  coverImage,
  ogImagePath,
} = Astro.props;

const periodText = formatPeriod(startDate, endDate) ?? formatDate(pubDate);
const cover = coverImage ?? placeholderCover;
const selectedOgImage = coverImage?.src ?? ogImagePath;
---

<BaseLayout
  title={title}
  description={description}
  kind="project"
  image={selectedOgImage}
  jsonLd={buildPersonJsonLd()}
>
  <article
    class="py-4 sm:py-8"
    data-pagefind-body
    data-pagefind-meta={`desc:${description}`}
  >
    <header class="mb-8 space-y-3 sm:mb-10" data-pagefind-ignore>
      <h1 class="text-text text-2xl font-bold sm:text-3xl">
        {title}
      </h1>

      <div>
        <Image
          src={cover}
          alt={title}
          width={1200}
          height={675}
          class="h-auto w-full object-cover"
          loading="eager"
          decoding="async"
        />
      </div>

      <p class="text-text-subtle text-xs sm:text-sm">
        {periodText}
      </p>

      {
        techStack.length > 0 && (
          <div class="flex flex-wrap items-center gap-x-1.5 gap-y-1">
            {techStack.map((name) => (
              <Badge>{name}</Badge>
            ))}
          </div>
        )
      }

      <ProjectCardLinks links={links} class="pt-1" />
    </header>

    <Prose>
      <slot />
    </Prose>
  </article>
</BaseLayout>
