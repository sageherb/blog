---
import type { JsonLdInput } from "@utils/jsonld";
import BaseHead from "@components/layout/BaseHead.astro";
import Footer from "@components/layout/Footer.astro";
import Header from "@components/layout/Header.astro";
import "@styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  kind?: "page" | "post" | "project";
  pubDate?: Date;
  jsonLd?: JsonLdInput;
  tags?: string[];
}

const { title, description, image, kind, pubDate, jsonLd, tags } = Astro.props;
---

<!doctype html>
<html lang="ko" class="h-full antialiased">
  <head>
    <script is:inline>
      try {
        const stored = localStorage.getItem("theme");
        if (
          stored === "dark" ||
          (!stored && window.matchMedia("(prefers-color-scheme: dark)").matches)
        ) {
          document.documentElement.classList.add("dark");
        }
      } catch {
        // 시크릿 모드, SecurityError 발생 시 기본 라이트 테마로 처리
      }
    </script>
    <BaseHead
      title={title}
      description={description}
      image={image}
      kind={kind}
      pubDate={pubDate}
      jsonLd={jsonLd}
      tags={tags}
    />
  </head>
  <body class="bg-background text-text flex min-h-dvh flex-col">
    <div class="mx-auto flex w-full max-w-3xl flex-1 flex-col px-4 sm:px-6">
      <Header />
      <main class="flex flex-1 flex-col">
        <slot />
      </main>
      <Footer />
    </div>
    <script is:inline type="module" src="/pagefind/pagefind-component-ui.js"
    ></script>
  </body>
</html>
