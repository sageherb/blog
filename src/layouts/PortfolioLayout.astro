---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import TechBadge from "@components/TechBadge.astro";
import placeholderCover from "@assets/portfolio/placeholder-cover.svg";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  startDate?: Date;
  endDate?: Date;
  techStack?: string[];
  links?: { github?: string; live?: string };
  coverImage?: ImageMetadata;
}

const {
  title,
  description,
  pubDate,
  startDate,
  endDate,
  techStack = [],
  links,
  coverImage,
} = Astro.props;

const formatYearMonth = (date: Date) =>
  date.toLocaleDateString("ko-KR", { year: "numeric", month: "long" });

const periodText = startDate
  ? `${formatYearMonth(startDate)} — ${endDate ? formatYearMonth(endDate) : "진행 중"}`
  : pubDate.toLocaleDateString("ko-KR", {
      year: "numeric",
      month: "long",
      day: "numeric",
    });
---

<BaseLayout
  title={title}
  description={description}
  kind="portfolio"
  image={(coverImage ?? placeholderCover).src}
>
  <article class="py-4 sm:py-8" data-pagefind-body>
    <meta data-pagefind-meta={`desc:${description}`} />
    <header class="mb-8 space-y-3 sm:mb-10" data-pagefind-ignore>
      <h1 class="text-text text-2xl font-bold sm:text-3xl">
        {title}
      </h1>

      <!-- meta: dates, techStack, links -->
      <div
        class="text-text-muted flex flex-wrap items-center gap-x-1.5 gap-y-1 text-sm"
      >
        <span class="text-sm">
          {periodText}
        </span>
        {
          techStack.length > 0 && (
            <>
              {techStack.map((name) => (
                <TechBadge name={name} size="sm" />
              ))}
            </>
          )
        }
      </div>

      {
        (links?.github || links?.live) && (
          <div class="flex flex-wrap items-center gap-4 pt-1">
            {links.github && (
              <a
                href={links.github}
                target="_blank"
                rel="noopener noreferrer"
                class="text-text-subtle hover:text-text inline-flex items-center gap-1.5 text-sm leading-none underline-offset-4 transition-colors hover:underline"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 16 16"
                  class="h-4 w-4 shrink-0 fill-current"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
                </svg>
                <span class="inline-block leading-none">GitHub</span>
              </a>
            )}
            {links.live && (
              <a
                href={links.live}
                target="_blank"
                rel="noopener noreferrer"
                class="text-text-subtle hover:text-text inline-flex items-center gap-1 text-sm leading-none underline-offset-4 transition-colors hover:underline"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  class="h-4 w-4 shrink-0"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path d="M14 5h5v5" />
                  <path d="M10 14 19 5" />
                  <path d="M19 14v4a1 1 0 0 1-1 1h-4" />
                  <path d="M5 10v8a1 1 0 0 0 1 1h8" />
                </svg>
                <span class="inline-block leading-none">Live</span>
              </a>
            )}
          </div>
        )
      }
    </header>

    <div
      class="prose prose-sm md:prose-base prose-article max-w-none"
    >
      <slot />
    </div>
  </article>
</BaseLayout>
