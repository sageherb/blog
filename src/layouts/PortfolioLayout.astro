---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import CardLinks from "@components/portfolio/CardLinks.astro";
import TechBadge from "@components/TechBadge.astro";
import placeholderCover from "@assets/portfolio/placeholder-cover.svg";
import { resolveOgImageUrl } from "@lib/og/image";
import { formatDate, formatPeriod } from "@utils/date";
import { buildPersonJsonLd } from "@utils/jsonld";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  startDate?: Date;
  endDate?: Date;
  techStack?: string[];
  links?: { github?: string; live?: string };
  coverImage?: ImageMetadata;
  ogImagePath?: string;
}

const {
  title,
  description,
  pubDate,
  startDate,
  endDate,
  techStack = [],
  links,
  coverImage,
  ogImagePath,
} = Astro.props;

const periodText = formatPeriod(startDate, endDate) ?? formatDate(pubDate);
const cover = coverImage ?? placeholderCover;
const selectedOgImage = resolveOgImageUrl({
  overrideUrl: coverImage?.src,
  autoUrl: ogImagePath,
});
---

<BaseLayout
  title={title}
  description={description}
  kind="portfolio"
  image={selectedOgImage}
  jsonLd={buildPersonJsonLd()}
>
  <article class="py-4 sm:py-8" data-pagefind-body>
    <meta data-pagefind-meta={`desc:${description}`} />
    <header class="mb-8 space-y-3 sm:mb-10" data-pagefind-ignore>
      <h1 class="text-text text-2xl font-bold sm:text-3xl">
        {title}
      </h1>

      <div>
        <Image
          src={cover}
          alt={title}
          width={1200}
          height={675}
          class="h-auto w-full object-cover"
          loading="eager"
          decoding="async"
        />
      </div>

      <p class="text-text-muted text-xs md:text-sm">
        {periodText}
      </p>

      {
        techStack.length > 0 && (
          <div class="flex flex-wrap items-center gap-x-1.5 gap-y-1">
            {techStack.map((name) => (
              <TechBadge name={name} size="sm" />
            ))}
          </div>
        )
      }

      <CardLinks links={links} class="pt-1" />
    </header>

    <div class="prose prose-sm md:prose-base prose-article max-w-none">
      <slot />
    </div>
  </article>
</BaseLayout>
