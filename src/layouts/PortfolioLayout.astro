---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import TechBadge from "@components/TechBadge.astro";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  links?: { github?: string; live?: string };
  coverImage?: ImageMetadata;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  tags = [],
  links,
  coverImage,
} = Astro.props;

const formattedPubDate = pubDate.toLocaleDateString("ko-KR", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const formattedUpdatedDate = updatedDate?.toLocaleDateString("ko-KR", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout
  title={title}
  description={description}
  kind="portfolio"
  image={coverImage?.src}
>
  <article class="py-12">
    <a
      href="/portfolio"
      class="text-link hover:text-link-hover text-sm transition-colors"
      >← 포트폴리오로</a
    >

    <header class="mt-6 mb-10 space-y-3">
      <h1 class="text-text text-2xl font-bold sm:text-3xl">
        {title}
      </h1>

      <!-- cover image -->
      {
        coverImage && (
          <div class="aspect-video overflow-hidden rounded">
            <Image
              src={coverImage}
              alt={title}
              width={800}
              height={450}
              loading="eager"
              class="h-full w-full object-cover"
            />
          </div>
        )
      }

      <!-- meta: dates, tags -->
      <div
        class="text-text-muted flex flex-wrap items-center gap-x-3 gap-y-1 text-xs"
      >
        <time datetime={pubDate.toISOString()}>{formattedPubDate}</time>
        {
          updatedDate && (
            <span>
              수정:{" "}
              <time datetime={updatedDate.toISOString()}>
                {formattedUpdatedDate}
              </time>
            </span>
          )
        }
        {
          tags.length > 0 && (
            <>
              {tags.map((name) => (
                <TechBadge name={name} />
              ))}
            </>
          )
        }
      </div>

      {
        (links?.github || links?.live) && (
          <div class="mt-0.5 flex flex-wrap gap-3">
            {links.github && (
              <a
                href={links.github}
                target="_blank"
                rel="noopener noreferrer"
                class="text-text-subtle hover:text-text inline-flex h-7 items-end gap-1.5 pb-0.5 text-sm leading-none underline-offset-4 transition-colors hover:underline"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 16 16"
                  class="h-4 w-4 shrink-0 fill-current"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
                </svg>
                <span class="inline-block leading-none">GitHub</span>
              </a>
            )}
            {links.live && (
              <a
                href={links.live}
                target="_blank"
                rel="noopener noreferrer"
                class="text-text-subtle hover:text-text inline-flex h-7 items-end gap-1 pb-0.5 text-sm leading-none underline-offset-4 transition-colors hover:underline"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  class="h-4 w-4 shrink-0"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path d="M14 5h5v5" />
                  <path d="M10 14 19 5" />
                  <path d="M19 14v4a1 1 0 0 1-1 1h-4" />
                  <path d="M5 10v8a1 1 0 0 0 1 1h8" />
                </svg>
                <span class="inline-block leading-none">Live</span>
              </a>
            )}
          </div>
        )
      }
    </header>

    <div data-pagefind-body class="prose max-w-none">
      <slot />
    </div>
  </article>
</BaseLayout>
