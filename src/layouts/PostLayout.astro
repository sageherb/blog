---
import type { ImageMetadata } from "astro";
import TagBadge from "@components/TagBadge.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { resolveOgImageUrl } from "@lib/og/image";
import { formatDate } from "@utils/date";
import { buildBlogPostingJsonLd, buildPersonJsonLd } from "@utils/jsonld";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags?: string[];
  coverImage?: ImageMetadata;
  ogImagePath?: string;
}

const {
  title,
  description,
  pubDate,
  tags = [],
  coverImage,
  ogImagePath,
} = Astro.props;

const formattedPubDate = formatDate(pubDate);

const selectedOgImage = resolveOgImageUrl({
  overrideUrl: coverImage?.src,
  autoUrl: ogImagePath,
});

const jsonLd = [
  buildBlogPostingJsonLd({
    title,
    description,
    pubDate,
    tags,
    canonicalPath: Astro.url.pathname,
    ogImagePath: selectedOgImage,
  }),
  buildPersonJsonLd(),
];
---

<BaseLayout
  title={title}
  description={description}
  kind="post"
  pubDate={pubDate}
  image={selectedOgImage}
  jsonLd={jsonLd}
>
  <article class="py-4 sm:py-8" data-pagefind-body>
    <meta data-pagefind-meta={`desc:${description}`} />
    <header class="mb-8 space-y-3 sm:mb-10" data-pagefind-ignore>
      <h1 class="text-text text-2xl font-bold sm:text-3xl">
        {title}
      </h1>
      <div
        class="text-text-muted flex flex-wrap items-center gap-x-1.5 gap-y-1 text-sm"
      >
        <time datetime={pubDate.toISOString()} class="text-text-subtle text-sm">
          {formattedPubDate}
        </time>
        {
          tags.length > 0 && (
            <>
              {tags.map((tag) => (
                <TagBadge tag={tag} size="sm" />
              ))}
            </>
          )
        }
      </div>
    </header>

    <div class="prose prose-sm md:prose-base prose-article max-w-none">
      <slot />
    </div>
  </article>
  <script>
    import "../scripts/copy-code";
  </script>
</BaseLayout>
