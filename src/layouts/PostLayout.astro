---
import type { SeoProps } from "@components/layout/BaseHead.astro";
import Badge from "@components/ui/Badge.astro";
import Prose from "@components/ui/Prose.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { formatDate } from "@utils/date";
import { buildPostPageJsonLd } from "@utils/jsonld";
import { tagPath } from "@utils/tags";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags?: string[];
  ogImagePath?: string;
}

const { title, description, pubDate, tags = [], ogImagePath } = Astro.props;

const formattedPubDate = formatDate(pubDate);

const seo = {
  title,
  description,
  ogType: "article",
  pubDate,
  image: ogImagePath,
  jsonLd: buildPostPageJsonLd({
    title,
    description,
    pubDate,
    tags,
    canonicalPath: Astro.url.pathname,
    ogImagePath,
  }),
  tags,
} satisfies SeoProps;
---

<BaseLayout seo={seo}>
  <article
    class="py-4 sm:py-8"
    data-pagefind-body
    data-pagefind-meta={`desc:${description}`}
  >
    <header class="mb-8 space-y-3 sm:mb-10" data-pagefind-ignore>
      <h1 class="text-text text-2xl font-bold sm:text-3xl">
        {title}
      </h1>
      <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
        <time
          datetime={pubDate.toISOString()}
          class="text-text-subtle text-xs sm:text-sm"
        >
          {formattedPubDate}
        </time>
        {tags.map((tag) => <Badge href={tagPath(tag)}>#{tag}</Badge>)}
      </div>
    </header>

    <Prose>
      <slot />
    </Prose>
  </article>
</BaseLayout>
