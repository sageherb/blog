---
import type { ImageMetadata } from "astro";
import Badge from "@components/ui/Badge.astro";
import Prose from "@components/ui/Prose.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { formatDate } from "@utils/date";
import { buildBlogPostingJsonLd, buildPersonJsonLd } from "@utils/jsonld";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags?: string[];
  coverImage?: ImageMetadata;
  ogImagePath?: string;
}

const {
  title,
  description,
  pubDate,
  tags = [],
  coverImage,
  ogImagePath,
} = Astro.props;

const formattedPubDate = formatDate(pubDate);

const selectedOgImage = coverImage?.src ?? ogImagePath;

const jsonLd = [
  buildBlogPostingJsonLd({
    title,
    description,
    pubDate,
    tags,
    canonicalPath: Astro.url.pathname,
    ogImagePath: selectedOgImage,
  }),
  buildPersonJsonLd(),
];
---

<BaseLayout
  title={title}
  description={description}
  kind="post"
  pubDate={pubDate}
  image={selectedOgImage}
  jsonLd={jsonLd}
>
  <article
    class="py-4 sm:py-8"
    data-pagefind-body
    data-pagefind-meta={`desc:${description}`}
  >
    <header class="mb-8 space-y-3 sm:mb-10" data-pagefind-ignore>
      <h1 class="text-text text-2xl font-bold sm:text-3xl">
        {title}
      </h1>
      <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
        <time
          datetime={pubDate.toISOString()}
          class="text-text-subtle text-xs sm:text-sm"
        >
          {formattedPubDate}
        </time>
        {
          tags.map((tag) => (
            <Badge href={`/tags/${encodeURIComponent(tag)}`}>#{tag}</Badge>
          ))
        }
      </div>
    </header>

    <Prose>
      <slot />
    </Prose>
  </article>
  <script>
    import "@scripts/copy-code";
  </script>
</BaseLayout>
