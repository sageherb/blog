---
import BaseLayout from "@layouts/BaseLayout.astro";
import CodeCopyIsland from "@components/islands/CodeCopyIsland";
import TagBadge from "@components/TagBadge.astro";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags?: string[];
  ogImage?: ImageMetadata;
}

const { title, description, pubDate, tags = [], ogImage } = Astro.props;

const formattedPubDate = pubDate.toLocaleDateString("ko-KR", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout
  title={title}
  description={description}
  kind="post"
  pubDate={pubDate}
  image={ogImage?.src}
>
  <article class="py-4">
    <header class="mb-8 space-y-3 sm:mb-10">
      <h1 class="text-text text-2xl font-bold sm:text-3xl">
        {title}
      </h1>
      <div
        class="text-text-muted flex flex-wrap items-center gap-x-1.5 gap-y-1 text-sm"
      >
        <time datetime={pubDate.toISOString()} class="text-text-subtle text-sm">
          {formattedPubDate}
        </time>
        {
          tags.length > 0 && (
            <>
              {tags.map((tag) => (
                <TagBadge tag={tag} size="sm" />
              ))}
            </>
          )
        }
      </div>
    </header>

    <div data-pagefind-body class="prose prose-article max-w-none">
      <slot />
    </div>
    <CodeCopyIsland client:load />
  </article>
</BaseLayout>
