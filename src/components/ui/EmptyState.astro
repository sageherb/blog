---
import { FileQuestionMark, FolderOpen, Inbox, SearchX } from "@lucide/astro";

interface Props {
  type: "blog" | "project" | "tag" | "notFound";
}

const icons = {
  blog: Inbox,
  project: FolderOpen,
  tag: SearchX,
  notFound: FileQuestionMark,
} as const;

const messages: Record<Props["type"], string> = {
  blog: "아직 작성된 글이 없습니다.",
  project: "아직 등록된 프로젝트가 없습니다.",
  tag: "이 태그에 해당하는 글이 없습니다.",
  notFound: "존재하지 않는 페이지입니다.",
};

const { type } = Astro.props;
const Icon = icons[type];
---

<div
  data-pagefind-ignore
  class="flex flex-1 flex-col items-center justify-center gap-3 px-6 py-12 text-center"
>
  <Icon class="text-accent-solid h-9 w-9" aria-hidden="true" />
  <p class="text-text-muted max-w-xs text-base leading-relaxed">
    {messages[type]}
  </p>
</div>
