---
interface Props {
  type: "blog" | "portfolio" | "tag";
}

const labels: Record<Props["type"], string> = {
  blog: "EMPTY",
  portfolio: "EMPTY",
  tag: "NO MATCH",
};

const messages: Record<Props["type"], string> = {
  blog: "아직 작성된 글이 없습니다.",
  portfolio: "아직 등록된 프로젝트가 없습니다.",
  tag: "이 태그에 해당하는 글이 없습니다.",
};

const { type } = Astro.props;
---

<div
  data-pagefind-ignore
  class="flex flex-1 flex-col items-center justify-center gap-3 px-6 py-12 text-center"
>
  <span
    class="text-accent-text text-[10px] font-semibold tracking-[0.3em] uppercase"
  >
    {labels[type]}
  </span>
  <p class="text-text-muted max-w-[24ch] text-sm leading-relaxed">
    {messages[type]}
  </p>
</div>
