---
interface Props {
  href?: string;
}

const { href } = Astro.props;

const baseClass =
  "bg-accent-soft text-link inline-flex h-5 items-center justify-center rounded-md px-2 text-xs leading-none sm:h-6 sm:text-sm";
---

{
  href ? (
    <a
      href={href}
      class:list={[
        baseClass,
        "hover:bg-accent-soft-hover font-normal transition-colors",
      ]}
    >
      <slot />
    </a>
  ) : (
    <span class={baseClass}>
      <slot />
    </span>
  )
}
