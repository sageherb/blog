---
import type { Page } from "astro";
import type { CollectionEntry, CollectionKey } from "astro:content";

interface Props {
  page: Page<CollectionEntry<CollectionKey>>;
  firstPageHref?: string;
}

const { page, firstPageHref } = Astro.props;

const baseUrl =
  page.currentPage === 1
    ? page.url.current
    : page.url.current.replace(/\/\d+\/?$/, "");

function getPageUrl(p: number): string {
  if (p === 1) return firstPageHref ?? baseUrl;
  return `${baseUrl}/${p}`;
}

const prevHref =
  firstPageHref && page.currentPage === 2 ? firstPageHref : page.url.prev;

function getPageItems(current: number, total: number): (number | "...")[] {
  if (total <= 7) {
    return Array.from({ length: total }, (_, i) => i + 1);
  }

  const result: (number | "...")[] = [1];
  const rangeStart = Math.max(2, current - 1);
  const rangeEnd = Math.min(total - 1, current + 1);

  if (rangeStart > 2) result.push("...");
  for (let i = rangeStart; i <= rangeEnd; i++) result.push(i);
  if (rangeEnd < total - 1) result.push("...");

  result.push(total);
  return result;
}

const items = getPageItems(page.currentPage, page.lastPage);
---

<nav
  aria-label="페이지 탐색"
  class="mt-3 flex items-center justify-center gap-2 pt-3 text-sm sm:mt-6 sm:pt-6"
>
  {
    prevHref ? (
      <a
        href={prevHref}
        aria-label="이전 페이지"
        class="text-text-muted hover:text-text px-1 transition-colors"
      >
        ←
      </a>
    ) : (
      <span aria-hidden="true" class="text-text-subtle/40 px-1 select-none">
        ←
      </span>
    )
  }

  <ol class="mx-2 flex items-center gap-3 tabular-nums">
    {
      items.map((item) =>
        item === "..." ? (
          <li
            aria-hidden="true"
            class="text-text-subtle leading-none select-none"
          >
            …
          </li>
        ) : (
          <li class="leading-none">
            <a
              href={getPageUrl(item)}
              aria-label={`${item}페이지`}
              aria-current={item === page.currentPage ? "page" : undefined}
              class:list={[
                "transition-colors",
                item === page.currentPage
                  ? "text-link decoration-accent-solid font-semibold underline decoration-2 underline-offset-4"
                  : "text-text-muted hover:text-text font-normal",
              ]}
            >
              {item}
            </a>
          </li>
        ),
      )
    }
  </ol>

  {
    page.url.next ? (
      <a
        href={page.url.next}
        aria-label="다음 페이지"
        class="text-text-muted hover:text-text px-1 transition-colors"
      >
        →
      </a>
    ) : (
      <span aria-hidden="true" class="text-text-subtle/40 px-1 select-none">
        →
      </span>
    )
  }
</nav>
