---
import type { Page } from "astro";
import type { CollectionEntry, CollectionKey } from "astro:content";
import { PAGE_BLOCK_SIZE } from "@config";
import { ChevronLeft, ChevronRight } from "@lucide/astro";
import { buildPageHref, getPageBlock } from "@utils/pagination";

interface Props {
  page: Page<CollectionEntry<CollectionKey>>;
}

const { page } = Astro.props;

const base = page.url.first ?? page.url.current;
const { pages, prevPage, nextPage } = getPageBlock(
  page.currentPage,
  page.lastPage,
  PAGE_BLOCK_SIZE,
);
---

<nav
  aria-label="페이지 탐색"
  class="mt-3 flex items-center justify-center gap-2 pt-3 text-sm sm:mt-6 sm:pt-6"
>
  {
    prevPage ? (
      <a
        href={buildPageHref(base, prevPage)}
        aria-label="이전 페이지"
        class="text-text-muted hover:text-text px-1 transition-colors"
      >
        <ChevronLeft class="size-4" aria-hidden="true" />
      </a>
    ) : (
      <span aria-hidden="true" class="text-text-subtle/40 px-1 select-none">
        <ChevronLeft class="size-4" />
      </span>
    )
  }

  <ol class="mx-2 flex items-center gap-3 tabular-nums">
    {
      pages.map((item) => (
        <li class="leading-none">
          <a
            href={buildPageHref(base, item)}
            aria-label={`${item}페이지`}
            aria-current={item === page.currentPage ? "page" : undefined}
            class:list={[
              "transition-colors",
              item === page.currentPage
                ? "text-link decoration-accent-solid font-semibold underline decoration-2 underline-offset-4"
                : "text-text-muted hover:text-text font-normal",
            ]}
          >
            {item}
          </a>
        </li>
      ))
    }
  </ol>

  {
    nextPage ? (
      <a
        href={buildPageHref(base, nextPage)}
        aria-label="다음 페이지"
        class="text-text-muted hover:text-text px-1 transition-colors"
      >
        <ChevronRight class="size-4" aria-hidden="true" />
      </a>
    ) : (
      <span aria-hidden="true" class="text-text-subtle/40 px-1 select-none">
        <ChevronRight class="size-4" />
      </span>
    )
  }
</nav>
