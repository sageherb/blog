---
interface Props {
  tag: string;
  size?: "xs" | "sm" | "base";
}

const { tag, size = "xs" } = Astro.props;

const sizeClass =
  size === "base"
    ? "h-7 px-2.5 text-base"
    : size === "sm"
      ? "h-6 px-2 text-sm"
      : "h-5 px-2 text-xs";
---

<a
  href={`/tags/${encodeURIComponent(tag)}`}
  class:list={[
    "bg-accent-soft text-link hover:bg-accent-soft-hover inline-flex items-center justify-center rounded-md font-normal transition-colors",
    sizeClass,
  ]}
>
  <span class="leading-none">#{tag}</span>
</a>
