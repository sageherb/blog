---
interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<aside
  role="note"
  aria-label={title}
  class="bg-accent-2 my-6 rounded-lg px-5 py-4"
>
  {title && <div class="text-accent-11 mb-1.5 text-sm font-bold">{title}</div>}
  <div class="[&>:first-child]:mt-0 [&>:last-child]:mb-0">
    <slot />
  </div>
</aside>
