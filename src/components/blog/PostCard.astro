---
import type { CollectionEntry } from "astro:content";
import TagBadge from "@components/ui/TagBadge.astro";
import { formatDate } from "@utils/date";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, description, pubDate, tags } = post.data;

const formattedDate = formatDate(pubDate);
---

<article class="flex flex-col gap-2">
  <a href={`/blog/${post.id}`} class="group block">
    <h2
      class="text-text group-hover:text-link text-lg font-semibold transition-colors sm:text-xl"
    >
      {title}
    </h2>
  </a>
  <p class="text-text-muted line-clamp-2 text-sm sm:text-base">{description}</p>
  <div class="flex flex-wrap items-center gap-x-1.5 gap-y-1">
    <time
      datetime={pubDate.toISOString()}
      class="text-text-subtle text-xs md:text-sm"
    >
      {formattedDate}
    </time>
    {
      tags.length > 0 && (
        <>
          {tags.map((tag) => (
            <TagBadge tag={tag} size="sm" />
          ))}
        </>
      )
    }
  </div>
</article>
