---
interface Props {
  tag: string;
}

const { tag } = Astro.props;
---

<a
  href={`/tags/${encodeURIComponent(tag)}`}
  class="bg-accent-soft text-link hover:bg-accent-soft-hover hover:text-link-hover inline-flex h-5 items-center justify-center rounded-md px-2 text-xs transition-colors"
>
  <span class="relative top-px inline-flex items-center leading-none"
    >#{tag}</span
  >
</a>
