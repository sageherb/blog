---
import { DEFAULT_OG_IMAGE, SITE_FAVICON, SITE_TITLE } from "@config";

interface Props {
  title: string;
  description: string;
  /** Root-relative path (e.g. "/og/post.png") or absolute URL. Falls back to DEFAULT_OG_IMAGE. */
  image?: string;
  /**
   * Page kind — controls og:type and article timestamps.
   *   "post"      → og:type="article" + article:published/modified_time
   *   "portfolio" → og:type="website"
   *   "page"      → og:type="website" (default)
   */
  kind?: "page" | "post" | "portfolio";
  /** Blog post publish date (post only) */
  pubDate?: Date;
  /** Blog post last updated date (post only) */
  updatedDate?: Date;
}

const {
  title,
  description,
  image,
  kind = "page",
  pubDate,
  updatedDate,
} = Astro.props;

const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : Astro.url;

const ogType = kind === "post" ? "article" : "website";

// resolve OG image to absolute URL — fall back to default if not provided
const ogImagePath = image ?? DEFAULT_OG_IMAGE;
const ogImage = Astro.site
  ? ogImagePath.startsWith("http")
    ? ogImagePath
    : new URL(ogImagePath, Astro.site).toString()
  : undefined;

const faviconSvg = `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>${SITE_FAVICON}</text></svg>`;
const faviconHref = `data:image/svg+xml,${encodeURIComponent(faviconSvg)}`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<!-- favicon -->
<link rel="icon" href={faviconHref} />

<!-- canonical & discovery -->
<link rel="canonical" href={canonicalURL} />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href="/rss.xml"
/>

<!-- primary meta -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="ko_KR" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{ogImage && <meta property="og:image" content={ogImage} />}
{
  kind === "post" && pubDate && (
    <meta property="article:published_time" content={pubDate.toISOString()} />
  )
}
{
  kind === "post" && updatedDate && (
    <meta
      property="article:modified_time"
      content={updatedDate.toISOString()}
    />
  )
}

<!-- Twitter / X Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{ogImage && <meta name="twitter:image" content={ogImage} />}
