---
import type { JsonLdInput, JsonLdObject } from "@utils/jsonld";
import { DEFAULT_OG_IMAGE, SITE_FAVICON, SITE_TITLE } from "@config";
import { escapeJsonForHtml } from "@utils/jsonld";

interface Props {
  title: string;
  description: string;
  image?: string;
  kind?: "page" | "post" | "portfolio";
  pubDate?: Date;
  canonical?: string | URL;
  jsonLd?: JsonLdInput;
}

function normalizeJsonLd(input: JsonLdInput | undefined): JsonLdObject[] {
  if (!input) return [];
  return Array.isArray(input) ? input : [input];
}

function buildCanonicalURL(
  canonical: string | URL | undefined,
  site: URL | undefined,
  url: URL,
): URL {
  if (!canonical) {
    return site ? new URL(url.pathname, site) : url;
  }
  if (canonical instanceof URL) return canonical;
  return site ? new URL(canonical, site) : new URL(canonical, url);
}

function resolveOgImage(
  path: string,
  site: URL | undefined,
): string | undefined {
  if (!site) return undefined;
  return path.startsWith("http") ? path : new URL(path, site).toString();
}

const {
  title,
  description,
  image,
  kind = "page",
  pubDate,
  canonical,
  jsonLd,
} = Astro.props;

const jsonLdItems = normalizeJsonLd(jsonLd);
const canonicalURL = buildCanonicalURL(canonical, Astro.site, Astro.url);
const ogType = kind === "post" ? "article" : "website";
const documentTitle = title === SITE_TITLE ? title : `${title} — ${SITE_TITLE}`;
const ogImage = resolveOgImage(image ?? DEFAULT_OG_IMAGE, Astro.site);

const faviconSvg = `<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>${SITE_FAVICON}</text></svg>`;
const faviconHref = `data:image/svg+xml,${encodeURIComponent(faviconSvg)}`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<link
  rel="stylesheet"
  as="style"
  crossorigin
  href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
/>

<link rel="icon" href={faviconHref} />

{
  import.meta.env.PROD && (
    <link rel="stylesheet" href="/pagefind/pagefind-component-ui.css" />
  )
}

<link rel="canonical" href={canonicalURL} />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href="/rss.xml"
/>

<title>{documentTitle}</title>
<meta name="description" content={description} />

<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="ko_KR" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{ogImage && <meta property="og:image" content={ogImage} />}
{
  kind === "post" && pubDate && (
    <meta property="article:published_time" content={pubDate.toISOString()} />
  )
}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{ogImage && <meta name="twitter:image" content={ogImage} />}

{
  jsonLdItems.map((ld) => (
    <script
      is:inline
      type="application/ld+json"
      set:html={escapeJsonForHtml(JSON.stringify(ld))}
    />
  ))
}
