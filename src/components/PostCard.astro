---
import type { CollectionEntry } from "astro:content";
import TagBadge from "@components/TagBadge.astro";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, description, pubDate, tags } = post.data;

const formattedDate = pubDate.toLocaleDateString("ko-KR", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<article class="py-8">
  <a href={`/blog/${post.id}`} class="group block space-y-2">
    <h2
      class="text-text group-hover:text-accent text-base font-semibold transition-colors"
    >
      {title}
    </h2>
    <p class="text-muted line-clamp-2 text-sm">{description}</p>
  </a>
  <div class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1">
    <time datetime={pubDate.toISOString()} class="text-muted text-xs">
      {formattedDate}
    </time>
    {
      tags.length > 0 && (
        <>
          <span class="text-border text-xs" aria-hidden="true">
            ·
          </span>
          {tags.map((tag) => (
            <TagBadge tag={tag} />
          ))}
        </>
      )
    }
  </div>
</article>
