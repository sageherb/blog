---
import type { CollectionEntry } from "astro:content";
import CardDescription from "@components/ui/CardDescription.astro";
import CardTitle from "@components/ui/CardTitle.astro";
import TagList from "@components/ui/TagList.astro";
import { formatPeriod } from "@utils/date";

interface Props {
  entry: CollectionEntry<"project">;
  href: string;
}

const { entry, href } = Astro.props;
const { title, description, startDate, endDate, techStack } = entry.data;
const periodText = formatPeriod(startDate, endDate);
---

<div class="flex flex-wrap items-baseline gap-3">
  <CardTitle href={href} inline>{title}</CardTitle>
  {
    periodText && (
      <span class="text-text-subtle text-xs sm:text-sm">{periodText}</span>
    )
  }
</div>

<CardDescription>{description}</CardDescription>

<TagList tags={techStack} />
