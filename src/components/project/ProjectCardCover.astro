---
import type { ImageMetadata } from "astro";
import placeholderCover from "@assets/project/placeholder-cover.svg";
import { Image } from "astro:assets";

interface Props {
  image?: ImageMetadata;
  alt: string;
  href: string;
}

const { image, alt, href } = Astro.props;
const cover = image ?? placeholderCover;
---

<a href={href} class="block aspect-video overflow-hidden">
  <Image
    src={cover}
    alt={alt}
    width={800}
    height={450}
    loading="lazy"
    class="h-full w-full object-cover"
  />
</a>
