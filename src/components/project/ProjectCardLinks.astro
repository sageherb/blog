---
import IconGithub from "@components/ui/IconGithub.astro";
import { ArrowUpRight } from "@lucide/astro";

interface Props {
  links?: { github?: string; live?: string };
  class?: string;
}

const { links, class: className = "" } = Astro.props;
const github = links?.github;
const live = links?.live;
---

{
  (github || live) && (
    <div class:list={["flex flex-wrap items-center gap-4", className]}>
      {github && (
        <a
          href={github}
          target="_blank"
          rel="noopener noreferrer"
          class="text-text-subtle hover:text-text inline-flex items-center gap-1 text-xs leading-none underline-offset-4 transition-colors hover:underline sm:text-sm"
        >
          <IconGithub class="h-4 w-4 shrink-0" aria-hidden="true" />
          <span class="inline-block leading-none">GitHub</span>
        </a>
      )}
      {live && (
        <a
          href={live}
          target="_blank"
          rel="noopener noreferrer"
          class="text-text-subtle hover:text-text inline-flex items-center gap-1 text-xs leading-none underline-offset-4 transition-colors hover:underline sm:text-sm"
        >
          <ArrowUpRight class="h-4 w-4 shrink-0" aria-hidden="true" />
          <span class="inline-block leading-none">Live</span>
        </a>
      )}
    </div>
  )
}
