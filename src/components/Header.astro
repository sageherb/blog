---
import PagefindSearch from "@components/PagefindSearch.astro";
import ThemeToggle from "@components/ThemeToggle";
import { SITE_FAVICON, SITE_TITLE } from "@config";

const path = Astro.url.pathname;

const navItems = [
  { href: "/about", label: "About" },
  { href: "/blog", label: "Blog" },
  { href: "/portfolio", label: "Portfolio" },
] as const;

function isActive(href: string): boolean {
  if (href === "/about") return path === "/about" || path === "/about/";
  return path === href || path.startsWith(href + "/");
}
---

<header
  data-pagefind-ignore
  class="flex items-center justify-between pt-4 pb-4 select-none sm:pt-12 sm:pb-8"
>
  <a
    href="/"
    aria-label={SITE_TITLE}
    class="text-text hover:text-link inline-flex h-9 w-9 items-center justify-center text-[24px] leading-none font-semibold transition-colors md:w-auto md:justify-start md:gap-2"
  >
    <span class="inline-flex items-center leading-none">{SITE_FAVICON}</span>
    <span class="hidden leading-none md:inline-block">{SITE_TITLE}</span>
  </a>

  <nav aria-label="Main navigation">
    <ul class="flex h-9 items-center gap-1">
      {
        navItems.map(({ href, label }) => (
          <li class="flex items-center">
            <a
              href={href}
              aria-current={isActive(href) ? "page" : undefined}
              class:list={[
                "inline-flex h-9 items-center rounded px-3 text-sm leading-none transition-colors",
                isActive(href)
                  ? "text-link font-medium"
                  : "text-text-muted hover:text-text",
              ]}
            >
              <span class="nav-item-label relative top-px" data-text={label}>
                {label}
              </span>
            </a>
          </li>
        ))
      }
      <li class="ml-1 flex items-center">
        {
          /* Hydrate immediately: the inline FOUC script in BaseLayout sets the
            theme class before paint, but the toggle button's icon swap and
            click handler must be live the moment the user can see/tap it. */
        }
        <ThemeToggle client:load />
      </li>
      <li class="flex items-center">
        <PagefindSearch />
      </li>
    </ul>
  </nav>
</header>
