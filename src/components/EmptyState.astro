---
interface Props {
  type: "blog" | "portfolio" | "tag";
}

const messages: Record<Props["type"], string> = {
  blog: "아직 작성된 글이 없습니다.",
  portfolio: "아직 등록된 프로젝트가 없습니다.",
  tag: "이 태그에 해당하는 글이 없습니다.",
};

const { type } = Astro.props;
---

<p
  data-pagefind-ignore
  class="text-text-muted flex flex-1 items-center justify-center text-sm"
>
  {messages[type]}
</p>
