---
interface Props {
  name: string;
  size?: "xs" | "sm" | "base";
}

const { name, size = "xs" } = Astro.props;

const sizeClass =
  size === "base"
    ? "h-7 px-2.5 text-base"
    : size === "sm"
      ? "h-6 px-2 text-sm"
      : "h-5 px-2 text-xs";
---

<span
  class:list={[
    "bg-accent-soft text-link inline-flex items-center justify-center rounded-md",
    sizeClass,
  ]}
>
  <span class="leading-none">{name}</span>
</span>
