---
interface Props {
  name: string;
  size?: "xs" | "sm" | "base";
}

const { name, size = "xs" } = Astro.props;
const badgeClass =
  size === "base"
    ? "bg-accent-soft text-link inline-flex h-7 items-center justify-center rounded-md px-2.5 text-base"
    : size === "sm"
      ? "bg-accent-soft text-link inline-flex h-6 items-center justify-center rounded-md px-2 text-sm"
      : "bg-accent-soft text-link inline-flex h-5 items-center justify-center rounded-md px-2 text-xs";
---

<span class={badgeClass}>
  <span class="leading-none">{name}</span>
</span>
