---
import { COPYRIGHT_NAME, LICENSE, SOCIAL_LINKS } from "@config";
---

<footer
  class="text-text-muted mt-4 flex select-none items-center justify-between py-3 text-xs sm:mt-8 sm:py-6"
>
  <p>© {new Date().getFullYear()} {COPYRIGHT_NAME}. {LICENSE}</p>
  {
    SOCIAL_LINKS.github && (
      <a
        href={SOCIAL_LINKS.github}
        target="_blank"
        rel="noopener noreferrer"
        class="text-link hover:text-link-hover transition-colors"
      >
        GitHub
      </a>
    )
  }
</footer>
