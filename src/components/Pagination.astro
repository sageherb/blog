---
import type { Page } from "astro";

interface Props {
  page: Page<unknown>;
}

const { page } = Astro.props;
---

<nav
  aria-label="페이지 탐색"
  class="border-border mt-12 flex items-center justify-between border-t pt-6 text-sm"
>
  {
    page.url.prev ? (
      <a
        href={page.url.prev}
        class="text-muted hover:text-text transition-colors"
      >
        ← 이전
      </a>
    ) : (
      <span />
    )
  }
  <span class="text-muted text-xs">
    {page.currentPage} / {page.lastPage}
  </span>
  {
    page.url.next ? (
      <a
        href={page.url.next}
        class="text-muted hover:text-text transition-colors"
      >
        다음 →
      </a>
    ) : (
      <span />
    )
  }
</nav>
