---
import type { Page } from "astro";

interface Props {
  page: Page<unknown>;
}

const { page } = Astro.props;

// Strip trailing page number to get base URL
const baseUrl =
  page.currentPage === 1
    ? page.url.current
    : page.url.current.replace(/\/\d+$/, "");

function getPageUrl(p: number): string {
  return p === 1 ? baseUrl : `${baseUrl}/${p}`;
}

// Returns page numbers and ellipsis markers.
// Pages <= 7: show all. More: show edges + window around current.
function getPageItems(current: number, total: number): (number | "...")[] {
  if (total <= 7) {
    return Array.from({ length: total }, (_, i) => i + 1);
  }

  const result: (number | "...")[] = [1];
  const rangeStart = Math.max(2, current - 1);
  const rangeEnd = Math.min(total - 1, current + 1);

  if (rangeStart > 2) result.push("...");
  for (let i = rangeStart; i <= rangeEnd; i++) result.push(i);
  if (rangeEnd < total - 1) result.push("...");

  result.push(total);
  return result;
}

const items = getPageItems(page.currentPage, page.lastPage);
---

<nav
  aria-label="페이지 탐색"
  class="border-border mt-12 flex items-center justify-center gap-1 border-t pt-6"
>
  <!-- 이전 -->
  {
    page.url.prev ? (
      <a
        href={page.url.prev}
        aria-label="이전 페이지"
        class="text-muted hover:text-text flex h-8 w-8 items-center justify-center rounded text-sm transition-colors"
      >
        ←
      </a>
    ) : (
      <span class="flex h-8 w-8 items-center justify-center rounded text-sm opacity-25 select-none">
        ←
      </span>
    )
  }

  <!-- 페이지 번호 -->
  {
    items.map((item) =>
      item === "..." ? (
        <span
          aria-hidden="true"
          class="text-muted flex h-8 w-8 items-center justify-center text-sm select-none"
        >
          …
        </span>
      ) : (
        <a
          href={getPageUrl(item)}
          aria-label={`${item}페이지`}
          aria-current={item === page.currentPage ? "page" : undefined}
          class:list={[
            "flex h-8 w-8 items-center justify-center rounded text-sm transition-colors",
            item === page.currentPage
              ? "bg-surface text-text font-semibold"
              : "text-muted hover:text-text",
          ]}
        >
          {item}
        </a>
      )
    )
  }

  <!-- 다음 -->
  {
    page.url.next ? (
      <a
        href={page.url.next}
        aria-label="다음 페이지"
        class="text-muted hover:text-text flex h-8 w-8 items-center justify-center rounded text-sm transition-colors"
      >
        →
      </a>
    ) : (
      <span class="flex h-8 w-8 items-center justify-center rounded text-sm opacity-25 select-none">
        →
      </span>
    )
  }
</nav>
