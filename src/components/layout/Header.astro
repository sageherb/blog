---
import Logo from "@assets/logos/filled.svg";
import PagefindSearch from "@components/layout/PagefindSearch.astro";
import ThemeToggle from "@components/layout/ThemeToggle.astro";
import { SITE_TITLE } from "@config";

const path = Astro.url.pathname;

const navItems = [
  { href: "/blog", label: "Blog" },
  { href: "/project", label: "Project" },
  { href: "/about", label: "About" },
] as const;

function isActive(href: string): boolean {
  if (href === "/about") return path === "/about" || path === "/about/";
  return path === href || path.startsWith(`${href}/`);
}
---

<header
  data-pagefind-ignore
  class="flex items-center justify-between pt-4 pb-4 select-none sm:pt-12 sm:pb-8"
>
  <a
    href="/blog"
    aria-label={SITE_TITLE}
    class="text-text hover:text-link inline-flex h-9 w-9 items-center justify-center text-2xl leading-none font-semibold transition-colors md:w-auto md:justify-start md:gap-2"
  >
    <Logo class="h-6 w-6 text-(--accent-9)" aria-hidden="true" />
    <span class="hidden leading-none md:inline-block">{SITE_TITLE}</span>
  </a>

  <div class="flex items-center gap-1">
    <nav aria-label="메뉴">
      <ul class="flex h-9 items-center gap-1">
        {
          navItems.map(({ href, label }) => {
            const active = isActive(href);
            return (
              <li class="flex items-center">
                <a
                  href={href}
                  aria-current={active ? "page" : undefined}
                  class:list={[
                    "inline-flex h-9 items-center rounded-sm px-3 text-sm leading-none transition-colors",
                    active
                      ? "text-link font-medium"
                      : "text-text-muted hover:text-text",
                  ]}
                >
                  <span
                    class="nav-item-label relative top-px"
                    data-text={label}
                  >
                    {label}
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
    <div
      role="group"
      aria-label="유틸리티"
      class="ml-1 flex h-9 items-center gap-1"
    >
      <ThemeToggle />
      <PagefindSearch />
    </div>
  </div>
</header>
