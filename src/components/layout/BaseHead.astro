---
import type { JsonLdInput, JsonLdObject } from "@utils/jsonld";
import faviconSvg from "@assets/logos/filled.svg?raw";
import {
  AUTHOR,
  BRAND_COLOR,
  DEFAULT_OG_IMAGE,
  SITE_DESCRIPTION,
  SITE_TITLE,
} from "@config";
import { escapeJsonForHtml } from "@utils/jsonld";
import { siteUrl } from "@utils/url";
import { SEO } from "astro-seo";

const faviconHref = `data:image/svg+xml,${encodeURIComponent(faviconSvg.replaceAll("currentColor", BRAND_COLOR))}`;

export interface SeoProps {
  title: string;
  description: string;
  image?: string;
  ogType?: "website" | "article" | "profile";
  pubDate?: Date;
  jsonLd?: JsonLdInput;
  tags?: string[];
  noindex?: boolean;
}

type Props = SeoProps;

function normalizeJsonLd(input: JsonLdInput | undefined): JsonLdObject[] {
  if (!input) return [];
  return Array.isArray(input) ? input : [input];
}

const {
  title,
  description,
  image,
  ogType = "website",
  pubDate,
  jsonLd,
  tags,
  noindex,
} = Astro.props;

const jsonLdItems = normalizeJsonLd(jsonLd);
const canonicalURL = siteUrl(Astro.url.pathname).toString();
const metaDescription = description.trim() || SITE_DESCRIPTION;
const ogImage = siteUrl(image ?? DEFAULT_OG_IMAGE).toString();
const isArticle = ogType === "article";
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
<link
  rel="stylesheet"
  as="style"
  crossorigin
  href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
/>

<link rel="icon" type="image/svg+xml" href={faviconHref} />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

<link rel="stylesheet" href="/pagefind/pagefind-component-ui.css" />

<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href="/rss.xml"
/>

<SEO
  title={title}
  titleTemplate={title === SITE_TITLE ? undefined : `%s | ${SITE_TITLE}`}
  description={metaDescription}
  canonical={canonicalURL}
  noindex={noindex}
  openGraph={{
    basic: {
      type: ogType,
      title,
      image: ogImage,
      url: canonicalURL,
    },
    image: {
      width: 1200,
      height: 630,
      type: "image/png",
      alt: title,
    },
    optional: {
      description: metaDescription,
      locale: "ko_KR",
      siteName: SITE_TITLE,
    },
    ...(isArticle
      ? {
          article: {
            authors: [AUTHOR],
            ...(pubDate ? { publishedTime: pubDate.toISOString() } : {}),
            ...(tags && tags.length > 0 ? { tags } : {}),
          },
        }
      : {}),
  }}
  twitter={{
    card: "summary_large_image",
  }}
  extend={{
    meta: isArticle ? [{ name: "author", content: AUTHOR }] : [],
  }}
/>

{
  jsonLdItems.map((ld) => (
    <script
      is:inline
      type="application/ld+json"
      set:html={escapeJsonForHtml(JSON.stringify(ld))}
    />
  ))
}
