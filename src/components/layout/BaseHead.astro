---
import type { JsonLdInput, JsonLdObject } from "@utils/jsonld";
import faviconSvg from "@assets/logos/filled.svg?raw";
import {
  AUTHOR,
  BRAND_COLOR,
  DEFAULT_OG_IMAGE,
  SITE_DESCRIPTION,
  SITE_TITLE,
} from "@config";
import { escapeJsonForHtml } from "@utils/jsonld";
import { siteUrl } from "@utils/url";

const faviconHref = `data:image/svg+xml,${encodeURIComponent(faviconSvg.replaceAll("currentColor", BRAND_COLOR))}`;

export interface SeoProps {
  title: string;
  description: string;
  image?: string;
  ogType?: "website" | "article" | "profile";
  pubDate?: Date;
  jsonLd?: JsonLdInput;
  tags?: string[];
}

type Props = SeoProps;

function normalizeJsonLd(input: JsonLdInput | undefined): JsonLdObject[] {
  if (!input) return [];
  return Array.isArray(input) ? input : [input];
}

const {
  title,
  description,
  image,
  ogType = "website",
  pubDate,
  jsonLd,
  tags,
} = Astro.props;

const jsonLdItems = normalizeJsonLd(jsonLd);
const canonicalURL = siteUrl(Astro.url.pathname);
const documentTitle = title === SITE_TITLE ? title : `${title} | ${SITE_TITLE}`;
const ogImage = siteUrl(image ?? DEFAULT_OG_IMAGE).toString();
const metaDescription = description.trim() || SITE_DESCRIPTION;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
<link
  rel="stylesheet"
  as="style"
  crossorigin
  href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
/>

<link rel="icon" type="image/svg+xml" href={faviconHref} />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

<link rel="stylesheet" href="/pagefind/pagefind-component-ui.css" />

<link rel="canonical" href={canonicalURL} />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href="/rss.xml"
/>

<title>{documentTitle}</title>
<meta name="description" content={metaDescription} />

<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="ko_KR" />
<meta property="og:title" content={title} />
<meta property="og:description" content={metaDescription} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:alt" content={title} />
{
  ogType === "article" && (
    <>
      <meta name="author" content={AUTHOR} />
      <meta property="article:author" content={AUTHOR} />
      {pubDate && (
        <meta
          property="article:published_time"
          content={pubDate.toISOString()}
        />
      )}
      {tags?.map((tag) => (
        <meta property="article:tag" content={tag} />
      ))}
    </>
  )
}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={metaDescription} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={title} />

{
  jsonLdItems.map((ld) => (
    <script
      is:inline
      type="application/ld+json"
      set:html={escapeJsonForHtml(JSON.stringify(ld))}
    />
  ))
}
