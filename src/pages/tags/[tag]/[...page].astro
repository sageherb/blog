---
import type { GetStaticPathsOptions, Page } from "astro";
import type { CollectionEntry } from "astro:content";
import BlogIndexSection from "@components/BlogIndexSection.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { POSTS_PER_PAGE, SITE_TITLE } from "@config";
import { getBlogPosts } from "@utils/content";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getBlogPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];

  return tags.flatMap((tag) => {
    const filtered = posts.filter((p) => p.data.tags.includes(tag));
    return paginate(filtered, {
      params: { tag },
      pageSize: POSTS_PER_PAGE,
    });
  });
}

interface Props {
  page: Page<CollectionEntry<"blog">>;
}

const { page } = Astro.props;
const { tag } = Astro.params;
---

<BaseLayout title={SITE_TITLE} description={`${tag} 태그가 붙은 글 목록`}>
  <BlogIndexSection page={page} emptyType="tag">
    <header slot="header" class="mb-8">
      <h1 class="text-text text-xl font-bold sm:text-2xl">
        <span class="text-link">#</span>{tag}
      </h1>
      <p class="text-text-muted mt-1 text-sm">{page.total}개의 글</p>
    </header>
  </BlogIndexSection>
</BaseLayout>
