---
import ProjectCard from "@components/portfolio/ProjectCard.astro";
import EmptyState from "@components/ui/EmptyState.astro";
import PageSection from "@components/ui/PageSection.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getPortfolioPosts } from "@utils/content";

const entries = await getPortfolioPosts();
---

<BaseLayout title="Portfolio" description="프로젝트 포트폴리오 목록">
  <PageSection>
    {
      entries.length === 0 ? (
        <EmptyState type="portfolio" />
      ) : (
        <ul class="flex flex-col gap-8">
          {entries.map((entry) => (
            <li>
              <ProjectCard entry={entry} />
            </li>
          ))}
        </ul>
      )
    }
  </PageSection>
</BaseLayout>
