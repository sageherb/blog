---
import ContentSection from "@components/ContentSection.astro";
import EmptyState from "@components/EmptyState.astro";
import PortfolioCard from "@components/portfolio/Card.astro";
import { SITE_TITLE } from "@config";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getPortfolioPosts } from "@utils/content";

const entries = await getPortfolioPosts();
const pageTitle = SITE_TITLE;
---

<BaseLayout title={pageTitle} description="프로젝트 모음">
  <ContentSection>
    {
      entries.length === 0 ? (
        <EmptyState type="portfolio" />
      ) : (
        <ul class="flex flex-col gap-8">
          {entries.map((entry) => (
            <li>
              <PortfolioCard entry={entry} />
            </li>
          ))}
        </ul>
      )
    }
  </ContentSection>
</BaseLayout>
