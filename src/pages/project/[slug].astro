---
import type { GetStaticPaths } from "astro";
import type { CollectionEntry } from "astro:content";
import PortfolioLayout from "@layouts/PortfolioLayout.astro";
import { getPortfolioPosts } from "@utils/content";
import { render } from "astro:content";

export const getStaticPaths = (async () => {
  const entries = await getPortfolioPosts();
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

interface Props {
  entry: CollectionEntry<"portfolio">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<PortfolioLayout
  title={entry.data.title}
  description={entry.data.description}
  pubDate={entry.data.pubDate}
  startDate={entry.data.startDate}
  endDate={entry.data.endDate}
  techStack={entry.data.techStack}
  links={entry.data.links}
  coverImage={entry.data.coverImage}
  ogImagePath={`/og/project/${entry.id}.png`}
>
  <Content />
</PortfolioLayout>
