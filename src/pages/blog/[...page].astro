---
import type { GetStaticPathsOptions, Page } from "astro";
import type { CollectionEntry } from "astro:content";
import PostList from "@components/blog/PostList.astro";
import { POSTS_PER_PAGE, SITE_TITLE } from "@config";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getBlogPosts } from "@utils/content";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getBlogPosts();
  return paginate(posts, { pageSize: POSTS_PER_PAGE }).filter(
    (entry) => entry.params.page !== undefined,
  );
}

interface Props {
  page: Page<CollectionEntry<"blog">>;
}

const { page } = Astro.props;
const description = `블로그 ${page.currentPage}페이지`;
---

<BaseLayout title={SITE_TITLE} description={description}>
  <PostList page={page} firstPageHref="/" />
</BaseLayout>
