---
import type { GetStaticPathsOptions, Page } from "astro";
import type { CollectionEntry } from "astro:content";
import BlogIndexSection from "@components/BlogIndexSection.astro";
import { POSTS_PER_PAGE, SITE_TITLE } from "@config";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getBlogPosts } from "@utils/content";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getBlogPosts();
  // Page 1 is served by `/` (canonical) and `/blog` (alt entry).
  // Astro's paginate emits page 1 with `params.page === undefined` — drop it
  // so `/blog/1` is never generated.
  return paginate(posts, { pageSize: POSTS_PER_PAGE }).filter(
    (entry) => entry.params.page !== undefined,
  );
}

interface Props {
  page: Page<CollectionEntry<"blog">>;
}

const { page } = Astro.props;
const description = `블로그 ${page.currentPage}페이지`;
---

<BaseLayout title={SITE_TITLE} description={description}>
  <BlogIndexSection page={page} />
</BaseLayout>
