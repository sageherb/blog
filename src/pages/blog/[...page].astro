---
import type { GetStaticPathsOptions, Page } from "astro";
import type { CollectionEntry } from "astro:content";
import ContentSection from "@components/ContentSection.astro";
import EmptyState from "@components/EmptyState.astro";
import Pagination from "@components/Pagination.astro";
import PostCard from "@components/PostCard.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { POSTS_PER_PAGE, SITE_DESCRIPTION, SITE_TITLE } from "@config";
import { getBlogPosts } from "@utils/content";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getBlogPosts();
  return paginate(posts, { pageSize: POSTS_PER_PAGE });
}

interface Props {
  page: Page<CollectionEntry<"blog">>;
}

const { page } = Astro.props;
const isFirstPage = page.currentPage === 1;
const pageTitle = SITE_TITLE;
const pageDescription = isFirstPage
  ? SITE_DESCRIPTION
  : `블로그 ${page.currentPage}페이지`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <ContentSection>
    {
      page.data.length === 0 ? (
        <EmptyState type="blog" />
      ) : (
        <ul class="flex flex-col gap-10">
          {page.data.map((post) => (
            <li>
              <PostCard post={post} />
            </li>
          ))}
        </ul>
      )
    }
  </ContentSection>
  {page.lastPage > 1 && <Pagination page={page} />}
</BaseLayout>
