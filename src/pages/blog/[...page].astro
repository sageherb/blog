---
import type { GetStaticPathsOptions, Page } from "astro";
import type { CollectionEntry } from "astro:content";
import PostList from "@components/blog/PostList.astro";
import { POSTS_PER_PAGE, SITE_DESCRIPTION } from "@config";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getBlogPosts } from "@utils/content";
import { buildPersonJsonLd, buildWebSiteJsonLd } from "@utils/jsonld";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getBlogPosts();
  return paginate(posts, { pageSize: POSTS_PER_PAGE });
}

interface Props {
  page: Page<CollectionEntry<"blog">>;
}

const { page } = Astro.props;
const jsonLd =
  page.currentPage === 1
    ? [buildWebSiteJsonLd(), buildPersonJsonLd()]
    : undefined;
---

<BaseLayout title="Blog" description={SITE_DESCRIPTION} jsonLd={jsonLd}>
  <PostList page={page} />
</BaseLayout>
