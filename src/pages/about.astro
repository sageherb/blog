---
import PageSection from "@components/ui/PageSection.astro";
import Prose from "@components/ui/Prose.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getEntry, render } from "astro:content";

const entry = await getEntry("about", "index");
if (!entry) throw new Error("About content not found");

const { Content } = await render(entry);
const { description } = entry.data;
---

<BaseLayout seo={{ title: "Sage", description, ogType: "profile" }}>
  <PageSection>
    <Prose>
      <Content />
    </Prose>
  </PageSection>
</BaseLayout>
