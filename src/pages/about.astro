---
import BaseLayout from "@layouts/BaseLayout.astro";
import { SITE_TITLE } from "@config";
import { getEntry, render } from "astro:content";
import ContentSection from "@components/ContentSection.astro";

const entry = await getEntry("about", "index");
if (!entry) throw new Error("About content not found");

const { Content } = await render(entry);
const { description } = entry.data;
---

<BaseLayout title={SITE_TITLE} description={description}>
  <ContentSection>
    <article class="prose prose-sm md:prose-base prose-article max-w-none">
      <Content />
    </article>
  </ContentSection>
</BaseLayout>
