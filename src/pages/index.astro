---
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";
import ContentSection from "@components/ContentSection.astro";
import EmptyState from "@components/EmptyState.astro";
import Pagination from "@components/Pagination.astro";
import PostCard from "@components/PostCard.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { POSTS_PER_PAGE, SITE_DESCRIPTION, SITE_TITLE } from "@config";
import { getBlogPosts } from "@utils/content";

const posts = await getBlogPosts();
const page: Page<CollectionEntry<"blog">> = {
  data: posts.slice(0, POSTS_PER_PAGE),
  start: 0,
  end: Math.min(POSTS_PER_PAGE, posts.length) - 1,
  total: posts.length,
  currentPage: 1,
  lastPage: Math.ceil(posts.length / POSTS_PER_PAGE),
  size: POSTS_PER_PAGE,
  url: {
    current: "/",
    prev: undefined,
    next: posts.length > POSTS_PER_PAGE ? "/blog/2" : undefined,
    first: undefined,
    last: undefined,
  },
};
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <ContentSection>
    {
      page.data.length === 0 ? (
        <EmptyState type="blog" />
      ) : (
        <ul class="flex flex-col gap-10">
          {page.data.map((post) => (
            <li>
              <PostCard post={post} />
            </li>
          ))}
        </ul>
      )
    }
  </ContentSection>
  {page.lastPage > 1 && <Pagination page={page} />}
</BaseLayout>
