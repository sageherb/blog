    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@lucide/astro": "^1.16.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.2.0",
    "@vercel/analytics": "^2.0.1",
    "astro": "^7.0.7",
    "astro-expressive-code": "^0.44.0",
    "astro-seo": "^1.1.0",
    "preact": "^10.28.4",
    "satori": "^0.25.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.1.0",
    "@astrojs/check": "^0.9.9",
